{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOqs5tMqqGm2vJL9Amr6lqk"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# === 1) Setup de workspace (Drive/Local) ===\n","from pathlib import Path\n","import os\n","\n","def em_colab() -> bool:\n","    try:\n","        import google.colab  # noqa: F401\n","        return True\n","    except Exception:\n","        return False\n","\n","IS_COLAB = em_colab()\n","\n","# Monta o Google Drive automaticamente se estiver no Colab e ainda não estiver montado\n","if IS_COLAB:\n","    drive_root = Path(\"/content/drive\")\n","    if not (drive_root / \"MyDrive\").exists():\n","        from google.colab import drive\n","        drive.mount(\"/content/drive\")\n","\n","def workspace_dir(env_var: str = \"ML_SINTOMAS_DIR\", default_subdir: str = \"ML_Sintomas\") -> Path:\n","    # 1) Prioriza variável de ambiente\n","    if os.getenv(env_var):\n","        return Path(os.getenv(env_var)).expanduser()\n","\n","    # 2) Colab: usa MyDrive se disponível\n","    if IS_COLAB:\n","        mydrive = Path(\"/content/drive/MyDrive\")\n","        if mydrive.exists():\n","            return mydrive / default_subdir\n","        # fallback: diretório local no Colab\n","        return Path(\"/content\") / default_subdir\n","\n","    # 3) Ambiente local: cria em ~/Documents (ou na home)\n","    docs = Path.home() / \"Documents\"\n","    base = docs if docs.exists() else Path.home()\n","    return base / default_subdir\n","\n","WS_DIR = workspace_dir()\n","WS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","print(f\"[OK] Workspace: {WS_DIR}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8UU8Xlmlv8U-","executionInfo":{"status":"ok","timestamp":1766022313799,"user_tz":180,"elapsed":33214,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"c29d6fc1-8848-4b1b-f647-3d80b1cc92e0"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","[OK] Workspace: /content/drive/MyDrive/ML_Sintomas\n"]}]},{"cell_type":"code","source":["%%writefile ml_sintomas_lexico_v3.py\n","# ml_sintomas_lexico_v3.py (núcleo enxuto p/ pipeline SEM triggers – foco em ML)\n","from __future__ import annotations\n","import re, unicodedata\n","from dataclasses import dataclass\n","from typing import List, Dict, Tuple, Optional, Sequence, Union\n","\n","import numpy as np\n","import pandas as pd\n","from urllib.parse import urlparse, parse_qs\n","\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","from sklearn.preprocessing import MultiLabelBinarizer\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.multiclass import OneVsRestClassifier\n","from sklearn.svm import LinearSVC\n","from sklearn.calibration import CalibratedClassifierCV\n","from scipy.sparse import hstack\n","from scipy.special import expit\n","\n","# -------------------- Helpers básicos --------------------\n","def set_seed(seed: int = 42):\n","    import random\n","    random.seed(seed)\n","    np.random.seed(seed)\n","\n","def is_url(s: str) -> bool:\n","    try:\n","        return urlparse(s).scheme in (\"http\", \"https\")\n","    except Exception:\n","        return False\n","\n","def to_gsheet_csv_url(s: str) -> Optional[str]:\n","    if not s:\n","        return None\n","    if not is_url(s) and len(s) > 20 and \"/\" not in s and \" \" not in s:\n","        return f\"https://docs.google.com/spreadsheets/d/{s}/export?format=csv\"\n","    if is_url(s) and \"docs.google.com/spreadsheets\" in s:\n","        try:\n","            sheet_id = s.split(\"/d/\")[1].split(\"/\")[0]\n","        except Exception:\n","            sheet_id = None\n","        gid = None\n","        u = urlparse(s)\n","        q = parse_qs(u.query or \"\")\n","        if \"gid\" in q and q[\"gid\"]:\n","            gid = q[\"gid\"][0]\n","        elif u.fragment and \"gid=\" in u.fragment:\n","            try:\n","                gid = u.fragment.split(\"gid=\")[1].split(\"&\")[0]\n","            except Exception:\n","                gid = None\n","        base = f\"https://docs.google.com/spreadsheets/d/{sheet_id}/export?format=csv\" if sheet_id else s\n","        return f\"{base}&gid={gid}\" if gid else base\n","    return None\n","\n","LabelRow = Union[str, Sequence[str]]\n","\n","def _canon(s: str) -> str:\n","    if s is None: return \"\"\n","    s = unicodedata.normalize(\"NFKC\", str(s)).strip()\n","    while \"  \" in s: s = s.replace(\"  \", \" \")\n","    return s.lower()\n","\n","def _split_if_str(labels: LabelRow, seps: Tuple[str, ...] = (\";\",)):\n","    if labels is None: return []\n","    try:\n","        if isinstance(labels, float) and np.isnan(labels): return []\n","    except Exception: pass\n","    if isinstance(labels, str):\n","        text = labels.strip()\n","        if not text or text.lower() in (\"nan\", \"none\"): return []\n","        for sep in seps[1:]: text = text.replace(sep, seps[0])\n","        return [p.strip() for p in text.split(seps[0]) if p.strip()]\n","    if isinstance(labels, (list, tuple, set)):\n","        return [str(x).strip() for x in labels if str(x).strip()]\n","    s = str(labels).strip()\n","    if not s or s.lower() in (\"nan\", \"none\"): return []\n","    return [s]\n","\n","def normalize_labels(rows_of_labels: Sequence[LabelRow], valid_classes: Sequence[str]) -> List[List[str]]:\n","    canon2pretty = {_canon(c): c for c in valid_classes}\n","    out: List[List[str]] = []\n","    for labs in rows_of_labels:\n","        items = _split_if_str(labs)\n","        cleaned, seen_local = [], set()\n","        for l in items:\n","            k = _canon(l)\n","            if k in canon2pretty and k not in seen_local:\n","                seen_local.add(k); cleaned.append(canon2pretty[k])\n","        out.append(cleaned)\n","    return out\n","\n","# -------------------- Léxico (apenas lista; TRIGGERS desativados) --------------------\n","LEXICO_SINTOMAS: List[str] = [\n","    \"Mãos ou pés frios e arroxeados\",\"Reação alérgica\",\"Perda progressiva da visão\",\"Visão embaçada progressiva\",\n","    \"Ausência de menstruação\",\"Menstruação excessiva\",\"Tosse\",\"Hemorragia gengival intensa\",\"Edema/Inchaço\",\n","    \"Perda súbita de coordenação\",\"Calafrios\",\"Dor durante relação sexual\",\n","    \"Delírio ou alucinações\",\"Perda de memória\",\"Insônia\",\"Sonolência excessiva\",\"Aumento súbito de sede ou fome\",\n","    \"Inchaço dos linfonodos\",\"Nódulo na mama\",\"Nódulo testicular\",\"Dor nos testículos\",\n","    \"Secreção mamilar (fora da amamentação)\",\"Sangue no sêmen\",\"Choro persistente\",\n","    \"Sensibilidade à luz ou som\",\n","    \"Dor no ouvido\",\"Alterações na fala\",\"Alterações visuais súbitas\",\"Queimação no peito\",\"Sangramento nasal\",\n","    \"Inchaço nos olhos ou face\",\"Ansiedade ou agitação intensas\",\"Alterações urinárias\",\n","    \"Corpo estranho nos olhos, ouvidos ou nariz\",\"Ferimentos ou cortes com objetos\",\n","    \"Engasgo ou obstrução das vias aéreas\",\"Sinais de intoxicação ou envenenamento\",\"Retenção urinária\",\n","    \"Dificuldade pra engolir\",\"Icterícia\",\"Corpo estranho na garganta\",\n","    \"Sangramento gastrointestinal\",\"Dor no ombro ou braço\",\"Náusea ou enjoo\",\n","    \"Dor na perna e dificuldade pra caminhar\",\"Dores no pescoço ou rigidez da nuca\",\"Comportamento estranho à normalidade\",\n","    \"Sangramento ativo\",\"Coceira na pele\",\"Trauma ou queda\",\"Infecção em ferida\",\"Convulsão\",\n","    \"Dificuldade respiratória\",\"Falta de ar\",\"Lesões na pele\",\"Dor ou olho vermelho\",\"Sangramento vaginal\",\n","    \"Dor ou dificuldade ao urinar\",\"Hipotensão\",\"Hipoglicemia\",\"Hiperglicemia\",\"Temperatura baixa\",\n","    \"Dor durante a gravidez\",\"Redução dos movimentos fetais\",\"Trabalho de parto\",\"Mordedura\",\"Queimadura\",\n","    \"Confusão mental\",\"Perda de consciência\",\"Trauma na cabeça\",\n","    \"Manchas anormais na pele\",\"Incontinência urinária\",\"Coriza e espirros\",\n","    \"Trauma grave\",\"Dor de dente\",\"Alteração na audição\",\"Dor de garganta\",\n","    \"Dor no peito\",\"Dor de cabeça\",\"Formigamento ou perda de força\",\n","    \"Vômito\",\"Dor abdominal\",\"Dor nas costas\",\"Febre\",\"Palpitações\",\"Diarreia\",\"Perda de peso súbita\",\n","    \"Acidente elétrico\",\"Afogamento\",\"Fratura ou luxação\",\"Insolação\",\"Exaustão por calor\",\n","    \"Exposição a fumaça ou incêndio\",\"Exposição a produtos químicos\",\"Desidratação\",\n","    \"Chiado no peito\",\"Tosse com sangue\",\"Rouquidão súbita ou persistente\",\n","    \"Expectoração com odor fétido\",\"Dormência em parte do corpo\",\n","    \"Visão dupla\",\"Pele fria e úmida associada a mal-estar\",\n","    \"Vômito com sangue\",\"Aumento do volume abdominal\",\"Sangue na urina\",\n","    \"Corrimento uretral anormal\",\"Corrimento vaginal fétido\",\"Dor pélvica cíclica\",\"Dor muscular\",\n","    \"Dor e rigidez articular\",\"Intolerância térmica\",\"Tontura\",\n","    \"Ataques de pânico\",\"Ideação suicida\",\"Movimentos involuntários\"\n","]\n","\n","# TRIGGERS desligados por padrão\n","TRIGGERS: Dict[str, List[str]] = {}\n","\n","# Mantém classes para compat, mas **não** são usadas no pipeline\n","@dataclass\n","class SymptomLexicon:\n","    terms: List[str]\n","    triggers_map: Dict[str, List[str]] | None = None\n","\n","class LexiconFeatures:\n","    \"\"\"Compat: não usada. Se chamada, retorna matriz de zeros com shape (n, n_sintomas).\"\"\"\n","    def __init__(self, lexicon: SymptomLexicon):\n","        self.lexicon = lexicon\n","        self.symptoms = list(lexicon.terms)\n","    def transform(self, X: List[str]) -> np.ndarray:\n","        return np.zeros((len(X), len(self.symptoms)), dtype=np.float32)\n","\n","# -------------------- Featurização + Modelo (só ML) --------------------\n","def build_vectorizers(texts: List[str]) -> Tuple[TfidfVectorizer, TfidfVectorizer]:\n","    vec_word = TfidfVectorizer(\n","        strip_accents=\"unicode\",\n","        lowercase=True,\n","        ngram_range=(1, 3),   # 1–3 ajuda frases curtas (“dor no peito”)\n","        min_df=1,\n","        max_df=0.95\n","    )\n","    vec_char = TfidfVectorizer(\n","        strip_accents=\"unicode\",\n","        lowercase=True,\n","        analyzer=\"char\",\n","        ngram_range=(3, 6),   # char-ngrams capturam variações/erros\n","        min_df=1\n","    )\n","    vec_word.fit(texts)\n","    vec_char.fit(texts)\n","    return vec_word, vec_char\n","\n","def featurize(texts: List[str], vec_word: TfidfVectorizer, vec_char: TfidfVectorizer):\n","    Xw = vec_word.transform(texts)\n","    Xc = vec_char.transform(texts)\n","    return hstack([Xw, Xc])\n","\n","class SintomasModel:\n","    def __init__(self, lexicon: SymptomLexicon, algoritmo: str = \"logreg\"):\n","        self.lexicon = lexicon\n","        self.vectorizer_word: Optional[TfidfVectorizer] = None\n","        self.vectorizer_char: Optional[TfidfVectorizer] = None\n","        self.clf = None\n","        self.mlb: Optional[MultiLabelBinarizer] = None\n","        self.algoritmo = algoritmo\n","        self.thresholds_: Optional[np.ndarray] = None\n","\n","    def fit(self, texts: List[str], labels: List[List[str]]):\n","        classes = list(self.lexicon.terms)\n","        Y_full = normalize_labels(labels, classes)\n","\n","        # Remove colunas 0%/100%\n","        Yb_full = MultiLabelBinarizer(classes=classes).fit_transform(Y_full)\n","        rates = Yb_full.mean(axis=0)\n","        keep = np.where((rates > 0.0) & (rates < 1.0))[0]\n","        classes = [classes[i] for i in keep]\n","\n","        self.mlb = MultiLabelBinarizer(classes=classes)\n","        Y = self.mlb.fit_transform(normalize_labels(labels, classes))\n","\n","        self.vectorizer_word, self.vectorizer_char = build_vectorizers(texts)\n","        X = featurize(texts, self.vectorizer_word, self.vectorizer_char)\n","\n","        if self.algoritmo == \"svm\":\n","            base = LinearSVC(class_weight=\"balanced\")\n","            self.clf = OneVsRestClassifier(CalibratedClassifierCV(base, method=\"sigmoid\", cv=3))\n","        else:\n","            base = LogisticRegression(max_iter=3000, class_weight=\"balanced\", solver=\"liblinear\", C=2.0)\n","            self.clf = OneVsRestClassifier(base)\n","        self.clf.fit(X, Y)\n","\n","    def predict_proba(self, texts: List[str]) -> np.ndarray:\n","        if self.vectorizer_word is None or self.vectorizer_char is None or self.clf is None:\n","            raise RuntimeError(\"Modelo não treinado.\")\n","        X = featurize(texts, self.vectorizer_word, self.vectorizer_char)\n","        if hasattr(self.clf, \"predict_proba\"):\n","            P = self.clf.predict_proba(X)\n","            # compat: se vier lista de arrays binários, empilha colunas\n","            if isinstance(P, list):\n","                P = np.column_stack([p[:, 1] if (p.ndim == 2 and p.shape[1] == 2) else p.ravel() for p in P])\n","            return P\n","        return expit(self.clf.decision_function(X))\n","\n","def decidir_labels(texto_usuario: str, probas: np.ndarray, classes: Sequence[str], conf_th: float = 0.35) -> List[str]:\n","    # 1) aplica limiar por classe (se existir) ou único\n","    ml_pos = {classes[i] for i, p in enumerate(probas) if p >= conf_th}\n","    # 2) fallback top-1 se nada acima do limiar e prob mínima razoável\n","    if not ml_pos and len(probas):\n","        top = int(np.argmax(probas))\n","        if probas[top] >= max(conf_th * 0.5, 0.15):\n","            ml_pos = {classes[top]}\n","    idx = {c: i for i, c in enumerate(classes)}\n","    return sorted(ml_pos, key=lambda s: probas[idx[s]], reverse=True)\n","\n","def predict_labels(model: SintomasModel, textos: List[str], conf_th: float = 0.35) -> List[List[str]]:\n","    prob = model.predict_proba(textos)\n","    classes = list(model.mlb.classes_)\n","    out = []\n","    for i, row in enumerate(prob):\n","        out.append(decidir_labels(textos[i], row, classes, conf_th))\n","    return out\n","\n","# -------------------- Dados --------------------\n","def carregar_base_csv(caminho_ou_link: str, text_col: str = \"text\", labels_col: str = \"labels\", labels_sep: str = \";\"):\n","    src = caminho_ou_link.strip()\n","    if is_url(src):\n","        url_csv = to_gsheet_csv_url(src) or src\n","        df = pd.read_csv(url_csv)\n","    else:\n","        maybe = to_gsheet_csv_url(src)\n","        df = pd.read_csv(maybe) if maybe else pd.read_csv(src)\n","\n","    def _auto(colname: str, df_cols: List[str], cands: List[str]) -> str | None:\n","        idx = {c.lower().strip(): c for c in df_cols}\n","        for cand in [colname] + cands:\n","            k = cand.lower().strip()\n","            if k in idx: return idx[k]\n","        return None\n","\n","    text_candidates   = [\"text\",\"texto\",\"frase\",\"mensagem\",\"entrada\",\"sentenca\",\"sentença\",\"utterance\"]\n","    labels_candidates = [\"labels\",\"label\",\"classes\",\"tags\",\"sintomas\",\"alvos\",\"targets\",\"y\"]\n","    tcol = _auto(text_col, list(df.columns), text_candidates)\n","    lcol = _auto(labels_col, list(df.columns), labels_candidates)\n","    if not tcol or not lcol:\n","        raise ValueError(f\"Não encontrei as colunas de texto/labels. Colunas: {list(df.columns)}\")\n","    texts = df[tcol].astype(str).tolist()\n","    labels_raw = df[lcol].tolist()\n","    labels = [_split_if_str(x, seps=(labels_sep,)) for x in labels_raw]\n","    return texts, labels\n","\n","# -------------------- Auditoria (informativa) --------------------\n","def audit_lexicon(verbose: bool = True) -> Tuple[set, set]:\n","    \"\"\"Mantida por compat. TRIGGERS estão desativados; apenas informa desalinhamentos se alguém reativar.\"\"\"\n","    lex_set, trig_set = set(LEXICO_SINTOMAS), set(TRIGGERS.keys())\n","    faltando = lex_set - trig_set\n","    sobrando = trig_set - lex_set\n","    if verbose:\n","        print(\"[INFO] Triggers estão desativados nesta versão (pipeline usa só ML).\")\n","        if faltando:\n","            print(\"[Aviso] No léxico e sem trigger:\", *sorted(list(faltando))[:10], \"...\" if len(faltando) > 10 else \"\", sep=\"\\n - \")\n","        if sobrando:\n","            print(\"[Aviso] Trigger sem léxico:\", *sorted(list(sobrando))[:10], \"...\" if len(sobrando) > 10 else \"\", sep=\"\\n - \")\n","    return faltando, sobrando\n","\n","__all__ = [\n","    \"set_seed\",\n","    \"LEXICO_SINTOMAS\",\"TRIGGERS\",\"audit_lexicon\",\n","    \"SymptomLexicon\",\"LexiconFeatures\",\n","    \"build_vectorizers\",\"featurize\",\n","    \"SintomasModel\",\"predict_labels\",\"normalize_labels\",\n","    \"carregar_base_csv\",\n","]\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9wEohrFcuO9z","executionInfo":{"status":"ok","timestamp":1766022316481,"user_tz":180,"elapsed":24,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"75b0a1e8-e0aa-4bca-f983-eeb780b9f8e8"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing ml_sintomas_lexico_v3.py\n"]}]},{"cell_type":"code","source":["CSV = \"https://docs.google.com/spreadsheets/d/1VR7_i3A_ezlgKKGDetvRuYaaM9XQBOqxY-bfuzQxjwU/edit?usp=sharing\""],"metadata":{"id":"J8Pw1IcjxiAf","executionInfo":{"status":"ok","timestamp":1766022325830,"user_tz":180,"elapsed":13,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}}},"execution_count":3,"outputs":[]},{"cell_type":"code","source":["# --- HOTFIX: injeta .extract na classe SymptomLexicon já importada ---\n","import re\n","from ml_sintomas_lexico_v3 import SymptomLexicon, normalize_labels\n","\n","def _extract(self, text: str):\n","    txt_norm = normalize(text)      # p/ casar nomes do léxico (normalizados)\n","    txt_raw  = text.casefold()      # p/ casar regex dos triggers (com acentos)\n","    hits = {}\n","\n","    # 1) nomes do léxico via pattern_global (em texto normalizado)\n","    if getattr(self, \"pattern_global\", None) is not None:\n","        for m in self.pattern_global.finditer(txt_norm):\n","            frag = normalize(m.group(1))\n","            canonical = self.map_norm_to_canonical.get(frag)\n","            if canonical:\n","                s, e = m.span()\n","                window = txt_norm[max(0, s-30): min(len(txt_norm), e+30)]\n","                if has_negation(window):\n","                    continue\n","                hits[canonical] = hits.get(canonical, 0) + 1\n","\n","    # 2) triggers específicos (regex) no texto cru\n","    for symptom, patterns in self.compiled_by_symptom.items():\n","        for pat in patterns:\n","            m = pat.search(txt_raw)\n","            if m:\n","                s, e = m.span()\n","                window_raw = txt_raw[max(0, s-30): min(len(txt_raw), e+30)]\n","                if has_negation(window_raw):\n","                    continue\n","                hits[symptom] = hits.get(symptom, 0) + 1\n","                break\n","    return hits\n","\n","# aplica o patch\n","SymptomLexicon.extract = _extract\n","\n","# checagem rápida\n","assert hasattr(SymptomLexicon, \"extract\"), \"Patch do método .extract falhou.\"\n"],"metadata":{"id":"t-Ag5kZ2w39n","executionInfo":{"status":"ok","timestamp":1766022329462,"user_tz":180,"elapsed":1868,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["# ===== CÉLULA ROBUSTA: limpeza e binarização de labels =====\n","import re\n","import unicodedata\n","import numpy as np\n","from sklearn.preprocessing import MultiLabelBinarizer\n","from ml_sintomas_lexico_v3 import (\n","    carregar_base_csv, LEXICO_SINTOMAS, TRIGGERS, SymptomLexicon, SintomasModel\n",")\n","\n","# ================== Parâmetros opcionais ==================\n","# Se você quiser carregar da planilha automaticamente quando Ytr/labels não existirem:\n","TEXT_COL   = globals().get(\"TEXT_COL\", \"frase\")       # ajuste se necessário\n","LABELS_COL = globals().get(\"LABELS_COL\", \"sintomas\")  # ajuste se necessário\n","LABELS_SEP = globals().get(\"LABELS_SEP\", \";\")         # ajuste se necessário\n","# ==========================================================\n","\n","# === 0) Helpers de normalização ===\n","def strip_accents_lower(s: str) -> str:\n","    s = unicodedata.normalize(\"NFKD\", s)\n","    s = \"\".join(ch for ch in s if not unicodedata.combining(ch))\n","    return s.lower()\n","\n","def normalize_label(s: str) -> str:\n","    s = str(s).strip()\n","    s = re.sub(r\"\\s+\", \" \", s)            # colapsa espaços\n","    s = re.sub(r\"\\s*,\\s*\", \", \", s)       # normaliza vírgulas\n","    s = re.sub(r\"\\s*;\\s*\", \"; \", s)       # normaliza ponto e vírgula\n","    # correções pontuais conhecidas\n","    if s.startswith(\"CCorpo estranho nos olhos\"):\n","        s = s.replace(\"CCorpo\", \"Corpo\", 1)\n","    return s\n","\n","# === 1) Tabela de aliases manuais -> destino no LEXICO_SINTOMAS ===\n","ALIASES = {\n","    \"CCorpo estranho nos olhos, ouvidos ou nariz\": \"Corpo estranho nos olhos, ouvidos ou nariz\",\n","    # adicione outros aliases aqui, se surgirem\n","}\n","\n","# Índice rápido do léxico por versão normalizada (sem acentos, minúsculas)\n","lex_norm_map = { strip_accents_lower(lbl): lbl for lbl in LEXICO_SINTOMAS }\n","\n","def canonize_to_lexicon(lbl: str) -> str:\n","    \"\"\"Mapeia o rótulo para a forma exata do léxico, quando possível.\"\"\"\n","    s = normalize_label(lbl)\n","    if s in ALIASES:\n","        s = ALIASES[s]\n","    key = strip_accents_lower(s)\n","    return lex_norm_map.get(key, s)  # se não achar no léxico, devolve s como veio\n","\n","# === 2) Obter Ytr (ordem de prioridade: Ytr -> labels -> CSV) ===\n","if \"Ytr\" in globals():\n","    _Y_source = \"Ytr (já no ambiente)\"\n","    _Y = globals()[\"Ytr\"]\n","elif \"labels\" in globals():\n","    _Y_source = \"labels (já no ambiente)\"\n","    _Y = globals()[\"labels\"]\n","else:\n","    if \"CSV\" not in globals():\n","        raise RuntimeError(\n","            \"Nem 'Ytr' nem 'labels' estão definidos e 'CSV' não foi encontrado.\\n\"\n","            \"Defina 'Ytr' (lista de listas), ou 'labels', ou então defina 'CSV' para eu carregar a base.\"\n","        )\n","    _Y_source = f\"carregado de CSV ({globals()['CSV']})\"\n","    _texts, _labels = carregar_base_csv(\n","        globals()[\"CSV\"], text_col=TEXT_COL, labels_col=LABELS_COL, labels_sep=LABELS_SEP\n","    )\n","    # opcionalmente você pode expor esses:\n","    globals()[\"texts\"]  = _texts\n","    globals()[\"labels\"] = _labels\n","    _Y = _labels\n","\n","# === 3) Limpeza das labels do dataset ===\n","Ytr_clean = []\n","for row in _Y:\n","    # garante lista\n","    if row is None or (isinstance(row, float) and np.isnan(row)):\n","        row = []\n","    if isinstance(row, str):\n","        # se veio string única com separador, divide\n","        row = [p.strip() for p in row.split(LABELS_SEP)] if LABELS_SEP in row else [row]\n","    fixed = [canonize_to_lexicon(x) for x in row if str(x).strip()]\n","    # remove duplicadas mantendo ordem\n","    seen = set()\n","    dedup = []\n","    for x in fixed:\n","        if x not in seen:\n","            seen.add(x)\n","            dedup.append(x)\n","    Ytr_clean.append(dedup)\n","\n","# === 4) Checagem de desconhecidas (após limpeza) ===\n","lex_set = set(LEXICO_SINTOMAS)\n","data_set = set([l for row in Ytr_clean for l in row])\n","unknown_after = sorted([l for l in data_set if l not in lex_set])\n","\n","print(f\"[INFO] Fonte das labels: {_Y_source}\")\n","print(f\"Total amostras: {len(Ytr_clean)}\")\n","print(f\"Labels distintas no dataset (limpas): {len(data_set)}\")\n","if unknown_after:\n","    print(\"Ainda fora do léxico (revise nomes ou adicione aliases):\")\n","    for u in unknown_after:\n","        print(\" -\", u)\n","else:\n","    print(\"OK: todas as labels batem com o léxico.\")\n","\n","# === 5) Binarização consistente com o léxico ===\n","mlb = MultiLabelBinarizer(classes=LEXICO_SINTOMAS)\n","Ytr_bin = mlb.fit_transform(Ytr_clean)  # agora sem warnings\n","\n","# === 6) Identificar colunas constantes e remover ===\n","rates = Ytr_bin.mean(axis=0)  # proporção de 1's por classe\n","always_one  = np.where(rates == 1.0)[0]\n","always_zero = np.where(rates == 0.0)[0]\n","\n","print(\"\\nSempre 1 (constantes positivas):\")\n","for i in always_one:\n","    print(i, mlb.classes_[i])\n","print(\"\\nSempre 0 (constantes negativas):\")\n","for i in always_zero:\n","    print(i, mlb.classes_[i])\n","\n","keep = np.where((rates > 0.0) & (rates < 1.0))[0]\n","Ytr_ok = Ytr_bin[:, keep]\n","classes_ok = [mlb.classes_[i] for i in keep]\n","print(f\"\\nClasses mantidas: {len(classes_ok)} / {len(mlb.classes_)}\")\n","\n","# Exponho no ambiente para uso posterior (treino etc.)\n","globals()[\"Ytr_clean\"]  = Ytr_clean\n","globals()[\"Ytr_bin\"]    = Ytr_bin\n","globals()[\"Ytr_ok\"]     = Ytr_ok\n","globals()[\"classes_ok\"] = classes_ok\n","globals()[\"mlb_full\"]   = mlb  # caso queira mapear depois\n","\n","# === 7) (Opcional) conferência rápida de um índice específico\n","probe_idx = 40\n","if len(mlb.classes_) > probe_idx:\n","    print(f\"\\nClasse[{probe_idx}]:\", mlb.classes_[probe_idx])\n","\n","print(\"\\n[OK] Limpeza e binarização concluídas.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vkCh2suXxZHG","executionInfo":{"status":"ok","timestamp":1766022344929,"user_tz":180,"elapsed":4288,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"83408947-6295-4bbc-b306-91e94ca7cba8"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["[INFO] Fonte das labels: carregado de CSV (https://docs.google.com/spreadsheets/d/1VR7_i3A_ezlgKKGDetvRuYaaM9XQBOqxY-bfuzQxjwU/edit?usp=sharing)\n","Total amostras: 25670\n","Labels distintas no dataset (limpas): 117\n","Ainda fora do léxico (revise nomes ou adicione aliases):\n"," - Náusea\n"," - dor\n","\n","Sempre 1 (constantes positivas):\n","\n","Sempre 0 (constantes negativas):\n","\n","Classes mantidas: 115 / 115\n","\n","Classe[40]: Corpo estranho na garganta\n","\n","[OK] Limpeza e binarização concluídas.\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/sklearn/preprocessing/_label.py:909: UserWarning: unknown class(es) ['Náusea', 'dor'] will be ignored\n","  warnings.warn(\n"]}]},{"cell_type":"code","source":["# === 2) Salvar modelo + léxico + metadados no Drive ===\n","from pathlib import Path\n","import json\n","from joblib import dump\n","\n","# nomes dos arquivos (mude aqui se quiser)\n","MODEL_NAME    = \"modelo_sintomas_v2.pkl\"\n","LEXICO_NAME   = \"lexico_triggers_v2.json\"\n","METADATA_NAME = \"metadata_v2.json\"\n","\n","# caminhos finais\n","MODEL_PATH    = Path(WS_DIR) / MODEL_NAME\n","LEXICO_PATH   = Path(WS_DIR) / LEXICO_NAME\n","METADATA_PATH = Path(WS_DIR) / METADATA_NAME\n","MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)\n","\n","# 0) checagens suaves\n","assert \"model\" in globals(), \"O objeto 'model' não existe. Treine ou carregue o modelo antes de salvar.\"\n","\n","# 1) salvar o modelo\n","# se for o SintomasModel do módulo, ele tem .save(); caso contrário, salva com joblib\n","try:\n","    model.save(str(MODEL_PATH))\n","except Exception:\n","    dump(model, MODEL_PATH)\n","\n","# 2) salvar léxico e triggers\n","from ml_sintomas_lexico_v3 import LEXICO_SINTOMAS, TRIGGERS\n","with open(LEXICO_PATH, \"w\", encoding=\"utf-8\") as f:\n","    json.dump({\"lexico\": list(LEXICO_SINTOMAS), \"triggers\": TRIGGERS}, f, ensure_ascii=False, indent=2)\n","\n","# 3) salvar metadados (usa o que existir no ambiente; cai em fallback se faltar algo)\n","meta = {\n","    \"fonte_csv\": str(globals().get(\"CSV\", \"\")) or None,\n","    \"n_amostras\": int(len(globals().get(\"Ytr_clean\", []))) if \"Ytr_clean\" in globals() else None,\n","    \"n_classes_dataset\": int(len(globals().get(\"classes_ok\", []))) if \"classes_ok\" in globals() else None,\n","    \"n_classes_modelo\": int(len(getattr(getattr(model, \"mlb\", None), \"classes_\", []))) if hasattr(model, \"mlb\") else None,\n","    \"algoritmo\": getattr(model, \"algoritmo\", None),\n","}\n","with open(METADATA_PATH, \"w\", encoding=\"utf-8\") as f:\n","    json.dump(meta, f, ensure_ascii=False, indent=2)\n","\n","print(\"[OK] Artefatos salvos:\")\n","print(\" - Modelo:   \", MODEL_PATH)\n","print(\" - Léxico:   \", LEXICO_PATH)\n","print(\" - Metadata: \", METADATA_PATH)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6wGlh276v3zg","executionInfo":{"status":"ok","timestamp":1766022865730,"user_tz":180,"elapsed":15063,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"fb0a47a3-dbf1-41a9-c8f9-0d3b996e9045"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["[OK] Artefatos salvos:\n"," - Modelo:    /content/drive/MyDrive/ML_Sintomas/modelo_sintomas_v2.pkl\n"," - Léxico:    /content/drive/MyDrive/ML_Sintomas/lexico_triggers_v2.json\n"," - Metadata:  /content/drive/MyDrive/ML_Sintomas/metadata_v2.json\n"]}]},{"cell_type":"code","source":["# ===== Treino estável SEM léxico/triggers (foco em recall) =====\n","import numpy as np\n","from pathlib import Path\n","from scipy.sparse import hstack\n","from sklearn.preprocessing import MultiLabelBinarizer\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.multiclass import OneVsRestClassifier\n","from sklearn.metrics import precision_score, recall_score\n","from sklearn.feature_extraction.text import TfidfVectorizer\n","import joblib\n","\n","from ml_sintomas_lexico_v3 import (\n","    carregar_base_csv, LEXICO_SINTOMAS, SymptomLexicon, SintomasModel, normalize_labels\n",")\n","# ====== SEGMENTAÇÃO E INFERÊNCIA COM MERGE ======\n","import re\n","from typing import List, Dict, Tuple\n","\n","# (opcional) mapa mínimo de gírias → forma canônica\n","GIRIAS = {\n","    r\"\\bs+\\b\": \"sim\",\n","    r\"\\bss+\\b\": \"sim\",\n","    r\"\\bn+\\b\": \"não\",\n","    r\"\\bnn+\\b\": \"não\",\n","    r\"\\bblz\\b\": \"beleza\",\n","    r\"\\bvlw\\b\": \"valeu\",\n","    r\"\\bflw\\b\": \"falou\",\n","    r\"\\bpqp\\b\": \"putz\",\n","    r\"\\bmds\\b\": \"meu deus\",\n","    r\"\\btd\\b\": \"tudo\",\n","    r\"\\btbm\\b\": \"também\",\n","    r\"\\baki\\b\": \"aqui\",\n","    r\"\\bvc\\b\": \"você\",\n","    r\"\\bce\\b\": \"você\",\n","    r\"\\bcc\\b\": \"com certeza\",\n","    r\"\\bpfv\\b\": \"por favor\",\n","    r\"\\bpf\\b\": \"por favor\",\n","    r\"\\bqq\\b\": \"qualquer\",\n","    r\"\\bkd\\b\": \"cadê\",\n","    r\"\\bpq\\b\": \"porque\",\n","    r\"\\bcmg\\b\": \"comigo\",\n","    r\"\\bctz\\b\": \"certeza\",\n","    r\"\\bngm\\b\": \"ninguém\",\n","    r\"\\btmj\\b\": \"tamo junto\",\n","    r\"\\btlg\\b\": \"tá ligado\",\n","    r\"\\bslc\\b\": \"você é louco\",\n","    r\"\\btbm\\b\": \"também\",\n","    r\"\\bent\\b\": \"então\"\n","}\n","\n","def normalizar_girias(texto: str) -> str:\n","    t = \" \" + (texto or \"\").lower() + \" \"\n","    for pattern, repl in GIRIAS.items():\n","        t = re.sub(pattern, \" \" + repl + \" \", t, flags=re.IGNORECASE)\n","    return re.sub(r\"\\s+\", \" \", t).strip()\n","\n","# split forte por pontuação terminal\n","_SENT_SPLIT = re.compile(r\"(?<=[\\.\\!\\?;])\\s+\")\n","# conectivos + vírgula (separa cláusulas)\n","_CONECTIVOS = r\"(?:e|mas|ent[aã]o|da[ií]|depois|desde|ap[oó]s|porque|por isso|logo|sendo que)\"\n","_CLAUSE_SPLIT = re.compile(rf\"\\s*(?:,|\\b{_CONECTIVOS}\\b)\\s*\", flags=re.IGNORECASE)\n","\n","def _tokenize(s: str) -> List[str]:\n","    return re.findall(r\"\\w+|\\S\", s, flags=re.UNICODE)\n","\n","def _chunk_tokens(tokens: List[str], max_tokens: int = 25) -> List[str]:\n","    out, cur = [], []\n","    for tok in tokens:\n","        cur.append(tok)\n","        if len(cur) >= max_tokens:\n","            out.append(\" \".join(cur)); cur = []\n","    if cur: out.append(\" \".join(cur))\n","    return out\n","\n","def segmentar_texto(texto: str, max_tokens: int = 25) -> List[str]:\n","    \"\"\"1) normaliza gírias; 2) quebra por sentença; 3) quebra por vírgulas/conectivos; 4) limita por tokens.\"\"\"\n","    if not (texto and texto.strip()):\n","        return []\n","    t = normalizar_girias(texto.strip())\n","\n","    # 1) sentenças\n","    sents, start = [], 0\n","    for m in _SENT_SPLIT.finditer(t):\n","        sents.append(t[start:m.start()].strip()); start = m.end()\n","    if start < len(t): sents.append(t[start:].strip())\n","    sents = [s for s in sents if s]\n","\n","    # 2) cláusulas por vírgula/conectivos\n","    clausulas = []\n","    for s in sents:\n","        partes = [p.strip() for p in _CLAUSE_SPLIT.split(s) if p.strip()]\n","        clausulas.extend(partes)\n","\n","    # 3) limitar por tokens\n","    pedacos = []\n","    for c in clausulas:\n","        toks = _tokenize(c)\n","        if len(toks) <= max_tokens:\n","            pedacos.append(c)\n","        else:\n","            pedacos.extend(_chunk_tokens(toks, max_tokens=max_tokens))\n","    return pedacos\n","\n","import numpy as np\n","\n","def merge_probs(prob_list: List[np.ndarray]) -> np.ndarray:\n","    \"\"\"p_final = 1 - Π(1 - p_i) por classe\"\"\"\n","    if not prob_list:\n","        return np.array([])\n","    stack = np.clip(np.vstack(prob_list), 1e-6, 1-1e-6)\n","    return 1.0 - np.prod(1.0 - stack, axis=0)\n","\n","def predict_proba_segmentado(model, texts: List[str], max_tokens: int = 25) -> np.ndarray:\n","    \"\"\"\n","    Para cada texto:\n","      - segmenta em pedaços\n","      - roda vectorizers/clf em cada pedaço\n","      - faz merge de probabilidades por classe\n","    Retorna matriz (n_texts, n_classes)\n","    \"\"\"\n","    n_classes = len(model.mlb.classes_)\n","    out = np.zeros((len(texts), n_classes), dtype=float)\n","\n","    # acessa objetos já treinados\n","    vec_w = model.vectorizer\n","    vec_c = model.vectorizer_char\n","    clf   = model.clf\n","\n","    for i, t in enumerate(texts):\n","        pedacos = segmentar_texto(t, max_tokens=max_tokens) or [t or \"\"]\n","        # TF-IDF por pedaço\n","        Xw = vec_w.transform(pedacos)\n","        Xc = vec_c.transform(pedacos)\n","        X  = hstack([Xw, Xc])\n","        # proba por pedaço\n","        if hasattr(clf, \"predict_proba\"):\n","            P = clf.predict_proba(X)\n","            if isinstance(P, list):\n","                P = np.column_stack([p[:, 1] if (p.ndim == 2 and p.shape[1] == 2) else p.ravel() for p in P])\n","        else:\n","            from scipy.special import expit\n","            scores = clf.decision_function(X)\n","            P = expit(scores) if getattr(scores, \"ndim\", 1) == 2 else expit(scores)[:, None]\n","        out[i, :] = merge_probs([P[j, :] for j in range(P.shape[0])])\n","    return out\n","\n","def decidir_labels_segmentado(model, probs_row: np.ndarray, limiar_inesp: float = 0.70) -> Dict[str, float]:\n","    \"\"\"Aplica thresholds por classe do próprio model.thresholds_. Se nada ≥ limiar_inesp, retorna __inespecifico__.\"\"\"\n","    labels = {}\n","    thr = getattr(model, \"thresholds_\", None)\n","    thr = thr if (thr is not None and len(thr) == probs_row.shape[0]) else np.full_like(probs_row, 0.5, dtype=float)\n","    for i, c in enumerate(model.mlb.classes_):\n","        if probs_row[i] >= thr[i]:\n","            labels[c] = float(probs_row[i])\n","    if not labels and probs_row.max() < limiar_inesp:\n","        return {\"__inespecifico__\": float(probs_row.max())}\n","    return labels\n","# ====== FIM: SEGMENTAÇÃO ======\n","\n","\n","# ------------------- Parâmetros -------------------\n","CSV = \"https://docs.google.com/spreadsheets/d/1VR7_i3A_ezlgKKGDetvRuYaaM9XQBOqxY-bfuzQxjwU/edit?usp=sharing\"\n","\n","# Ajustes pró-recall\n","TARGET_PREC   = 0.70\n","THR_GRID      = np.linspace(0.02, 0.80, 40)\n","F_BETA        = 2.0           # prioriza recall\n","MARGIN_SHIFT  = -0.03         # puxa limiar p/ baixo\n","GLOBAL_MIN_T  = 0.12          # piso global baixo\n","SEED          = 42\n","# ---------------------------------------------------\n","\n","# 1) Carregar dados\n","texts, labels = carregar_base_csv(CSV, text_col=\"frase\", labels_col=\"sintomas\", labels_sep=\";\")\n","\n","# 1.1) Checagem rápida de cobertura das classes (útil p/ debug)\n","classes_ref = [str(c).strip() for c in LEXICO_SINTOMAS if c and str(c).strip()]\n","present = set(l for row in labels for l in row)\n","missing_in_data = sorted([c for c in classes_ref if c not in present])\n","print(f\"[CHECK] Classes do léxico que NÃO aparecem em nenhuma amostra da base: {len(missing_in_data)}\")\n","if missing_in_data:\n","    print(missing_in_data[:30], \"...\")  # evita printar gigante\n","# Obs: classe que nunca aparece na base não terá como o modelo aprender.\n","\n","# 2) Split 80/20\n","rng = np.random.default_rng(SEED)\n","idx = np.arange(len(texts))\n","rng.shuffle(idx)\n","cut = int(0.8 * len(texts))\n","tr_idx, va_idx = idx[:cut], idx[cut:]\n","Xtr = [texts[i] for i in tr_idx]\n","Ytr = [labels[i] for i in tr_idx]\n","Xv  = [texts[i] for i in va_idx]\n","Yv  = [labels[i] for i in va_idx]\n","if len(Xv) == 0:\n","    raise ValueError(\"Fold de validação ficou vazio. Ajuste o split ou aumente o dataset.\")\n","\n","# 3) Normalização das labels para as classes fixas\n","classes = list(dict.fromkeys(classes_ref))\n","Ytr_norm = normalize_labels(Ytr, classes)\n","Yv_norm  = normalize_labels(Yv,  classes)\n","\n","# 4) Binarização com classes FIXAS\n","mlb = MultiLabelBinarizer(classes=classes)\n","mlb.fit([])  # congela classes\n","Ytr_bin = mlb.transform(Ytr_norm)\n","Yv_bin  = mlb.transform(Yv_norm)\n","\n","# 5) TF-IDF (word + char), sem léxico\n","vec_word = TfidfVectorizer(\n","    strip_accents=\"unicode\",\n","    lowercase=True,\n","    ngram_range=(1, 3),  # captura “dor no peito” etc.\n","    min_df=1,\n","    max_df=0.95\n",")\n","vec_char = TfidfVectorizer(\n","    strip_accents=\"unicode\",\n","    lowercase=True,\n","    analyzer=\"char\",\n","    ngram_range=(3, 6),\n","    min_df=1\n",")\n","\n","Xtr_w = vec_word.fit_transform(Xtr)\n","Xv_w  = vec_word.transform(Xv)\n","\n","Xtr_c = vec_char.fit_transform(Xtr)\n","Xv_c  = vec_char.transform(Xv)\n","\n","Xtr_all = hstack([Xtr_w, Xtr_c])\n","Xv_all  = hstack([Xv_w,  Xv_c])\n","\n","# 6) Classificador OVR “solto” e balanceado\n","clf = OneVsRestClassifier(\n","    LogisticRegression(\n","        solver=\"liblinear\",\n","        max_iter=4000,\n","        C=3.0,                   # menos regularização\n","        class_weight=\"balanced\", # ajuda classes raras\n","        penalty=\"l2\"\n","    )\n",")\n","clf.fit(Xtr_all, Ytr_bin)\n","\n","# 7) Probabilidades na validação\n","if hasattr(clf, \"predict_proba\"):\n","    Pv = clf.predict_proba(Xv_all)\n","    if isinstance(Pv, list):\n","        Pv = np.column_stack([p[:, 1] if (p.ndim == 2 and p.shape[1] == 2) else p.ravel() for p in Pv])\n","else:\n","    from scipy.special import expit\n","    scores = clf.decision_function(Xv_all)\n","    Pv = expit(scores) if getattr(scores, \"ndim\", 1) == 2 else expit(scores)[:, None]\n","\n","assert Pv.shape == Yv_bin.shape, f\"Shape mismatch: Pv {Pv.shape} vs Yv_bin {Yv_bin.shape}\"\n","\n","# 8) Escolha de limiar agressiva por classe (prioriza recall)\n","def fbeta_score_prec(y_true, y_prob, thr, beta=F_BETA):\n","    y_pred = (y_prob >= thr).astype(int)\n","    p = precision_score(y_true, y_pred, zero_division=0)\n","    r = recall_score(y_true, y_pred, zero_division=0)\n","    if p == 0 and r == 0:\n","        return 0.0\n","    beta2 = beta**2\n","    return (1 + beta2) * (p * r) / (beta2 * p + r + 1e-12)\n","\n","n_classes = Yv_bin.shape[1]\n","best_thr = np.full(n_classes, 0.30, dtype=float)\n","\n","for j in range(n_classes):\n","    y_true = Yv_bin[:, j]\n","    y_prob = Pv[:, j]\n","\n","    if y_true.sum() == 0:\n","        best_thr[j] = max(GLOBAL_MIN_T, 0.25)\n","        continue\n","\n","    candidates = []\n","    for t in THR_GRID:\n","        y_pred = (y_prob >= t).astype(int)\n","        prec = precision_score(y_true, y_pred, zero_division=0)\n","        rec  = recall_score(y_true, y_pred, zero_division=0)\n","        if prec >= TARGET_PREC:\n","            candidates.append((t, prec, rec))\n","    if candidates:\n","        candidates.sort(key=lambda x: (-x[2], x[0]))  # maior recall, depois menor t\n","        chosen_t = candidates[0][0]\n","    else:\n","        fbest, chosen_t = -1.0, 0.25\n","        for t in THR_GRID:\n","            f = fbeta_score_prec(y_true, y_prob, t, beta=F_BETA)\n","            if f > fbest:\n","                fbest, chosen_t = f, t\n","\n","    chosen_t = float(np.clip(chosen_t + MARGIN_SHIFT, GLOBAL_MIN_T, 0.95))\n","    best_thr[j] = chosen_t\n","\n","print(\"Limiares por classe (ordem = mlb.classes_) — agressivos (sem léxico):\")\n","print(best_thr)\n","print(f\"\\nResumo: min={best_thr.min():.2f} | mediana={np.median(best_thr):.2f} | max={best_thr.max():.2f}\")\n","\n","# 9) Salvar no wrapper\n","#    Observação: seguimos instanciando o SymptomLexicon só p/ manter compat (sem triggers)\n","lex_vazio = SymptomLexicon(LEXICO_SINTOMAS, {})  # <— posicional\n","model = SintomasModel(lex_vazio, algoritmo=\"logreg\")\n","model.vectorizer = vec_word\n","model.vectorizer_char = vec_char\n","model.mlb = mlb\n","model.clf = clf\n","model.thresholds_ = best_thr\n","\n","SAVE_BASE = Path(globals().get(\"WS_DIR\", \"/content\"))\n","SAVE_BASE.mkdir(parents=True, exist_ok=True)\n","save_path = SAVE_BASE / \"modelo_sintomas_v3_nolex.pkl\"\n","joblib.dump(model, save_path)\n","print(f\"[OK] Modelo treinado e salvo em: {save_path}\")\n","\n","# 10) (Opcional) sanity-check rápido em frases de teste — **USANDO SEGMENTAÇÃO**\n","classes = list(mlb.classes_)\n","\n","def debug_predict_segmentado(samples, top_k=5, max_tokens=25):\n","    P = predict_proba_segmentado(model, samples, max_tokens=max_tokens)  # (n, n_classes)\n","    resultados = []\n","    for i in range(P.shape[0]):\n","        probs = P[i]\n","        # aplica thresholds do próprio model\n","        yhat = (probs >= model.thresholds_).astype(int)\n","        labels_on = [classes[k] for k, v in enumerate(yhat) if v == 1]\n","        # fallback \"inespecífico\"\n","        if not labels_on and probs.max() < 0.70:\n","            labels_on = [\"__inespecifico__\"]\n","        top_idx = np.argsort(-probs)[:top_k]\n","        tops = [(classes[k], float(probs[k])) for k in top_idx]\n","        resultados.append((labels_on, tops))\n","    return resultados\n","\n","samples = [\n","    \"vomitei, fiquei tonto e depois desmaiei\",\n","    \"tô com dor no peito e falta de ar quando subo escada\",\n","    \"o olho tá vermelho, ardendo, e a visão fica meio dupla às vezes\",\n","    \"caí no chão, ralei o braço, mas depois comecei a ter febre\",\n","    \"tô zuado, passando mal desde ontem, meio bolado com palpitações\"\n","]\n","preds = debug_predict_segmentado(samples)\n","for s, (labs, tops) in zip(samples, preds):\n","    print(f'\"{s}\" -> {labs} | TOPS: {tops}')\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TW459pBmyQ0p","executionInfo":{"status":"ok","timestamp":1766022735488,"user_tz":180,"elapsed":351488,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"24a17d9a-bb23-484b-e601-9f0407357b06"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["[CHECK] Classes do léxico que NÃO aparecem em nenhuma amostra da base: 0\n","Limiares por classe (ordem = mlb.classes_) — agressivos (sem léxico):\n","[0.45 0.49 0.29 0.53 0.23 0.49 0.77 0.53 0.53 0.67 0.67 0.21 0.31 0.39\n"," 0.63 0.37 0.69 0.61 0.45 0.73 0.73 0.57 0.15 0.35 0.63 0.75 0.53 0.73\n"," 0.73 0.43 0.53 0.47 0.45 0.49 0.73 0.13 0.65 0.73 0.59 0.17 0.77 0.63\n"," 0.51 0.33 0.71 0.55 0.35 0.47 0.35 0.37 0.33 0.59 0.41 0.77 0.53 0.63\n"," 0.63 0.27 0.69 0.63 0.73 0.75 0.71 0.23 0.75 0.12 0.49 0.29 0.61 0.71\n"," 0.69 0.37 0.19 0.71 0.23 0.43 0.47 0.69 0.49 0.75 0.41 0.67 0.51 0.19\n"," 0.21 0.25 0.29 0.21 0.49 0.37 0.33 0.45 0.23 0.51 0.49 0.31 0.51 0.35\n"," 0.39 0.33 0.13 0.65 0.59 0.67 0.67 0.75 0.43 0.55 0.63 0.69 0.65 0.57\n"," 0.65 0.29 0.43]\n","\n","Resumo: min=0.12 | mediana=0.51 | max=0.77\n","[OK] Modelo treinado e salvo em: /content/drive/MyDrive/ML_Sintomas/modelo_sintomas_v3_nolex.pkl\n","\"vomitei, fiquei tonto e depois desmaiei\" -> ['Perda de consciência', 'Vômito', 'Insolação', 'Vômito com sangue', 'Tontura'] | TOPS: [('Vômito', 0.9999990230377841), ('Perda de consciência', 0.999990700022659), ('Tontura', 0.9997984691746808), ('Vômito com sangue', 0.9991881396008794), ('Insolação', 0.5009933549703519)]\n","\"tô com dor no peito e falta de ar quando subo escada\" -> ['Dificuldade respiratória', 'Falta de ar', 'Dor no peito'] | TOPS: [('Dor no peito', 0.9999785856011286), ('Falta de ar', 0.9920859044536892), ('Dificuldade respiratória', 0.6420288505446603), ('Queimação no peito', 0.24456206887363852), ('Dor de garganta', 0.18214092211708433)]\n","\"o olho tá vermelho, ardendo, e a visão fica meio dupla às vezes\" -> ['Dor ou olho vermelho', 'Dor ou dificuldade ao urinar', 'Visão dupla'] | TOPS: [('Dor ou olho vermelho', 0.9999846188593902), ('Visão dupla', 0.9928807787207553), ('Dor ou dificuldade ao urinar', 0.5263431932756389), ('Queimadura', 0.44120061449781545), ('Visão embaçada progressiva', 0.419178133236053)]\n","\"caí no chão, ralei o braço, mas depois comecei a ter febre\" -> ['Dor no ombro ou braço', 'Trauma ou queda', 'Infecção em ferida', 'Convulsão', 'Perda de consciência', 'Febre', 'Fratura ou luxação', 'Dormência em parte do corpo'] | TOPS: [('Dor no ombro ou braço', 0.997895211146885), ('Febre', 0.9923966834242861), ('Trauma ou queda', 0.9605396721614203), ('Convulsão', 0.9450145303808833), ('Perda de consciência', 0.7211997671901151)]\n","\"tô zuado, passando mal desde ontem, meio bolado com palpitações\" -> ['Palpitações'] | TOPS: [('Palpitações', 0.9311593328029142), ('Sinais de intoxicação ou envenenamento', 0.6204718680540501), ('Vômito', 0.3463257808065826), ('Alteração na audição', 0.28778963603758945), ('Perda de memória', 0.2736205605523082)]\n"]}]},{"cell_type":"code","execution_count":24,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EBkwbkdCtLP0","executionInfo":{"status":"ok","timestamp":1766024812133,"user_tz":180,"elapsed":2250,"user":{"displayName":"Breno D'alkmin","userId":"03163286380110226447"}},"outputId":"89245106-182a-4fb0-eb49-579d78619c6c"},"outputs":[{"output_type":"stream","name":"stdout","text":["\"Tô com mó dor no peito faz uns 2 dias\" -> ['Dor no peito']\n","\"Quando tento ler, tá tudo embaçando aos poucos\" -> ['Visão embaçada progressiva']\n","\"Meu bebê tá com febre e chorando muito\" -> ['Choro persistente', 'Febre']\n","\"Engasguei com a carne no almoço e faltou ar\" -> ['Engasgo ou obstrução das vias aéreas']\n","\"Peito tá queimando\" -> ['Queimação no peito']\n"]}],"source":["# ===== PREDIÇÃO: carregar modelo salvo (joblib) e testar (SEM triggers) =====\n","from pathlib import Path\n","import numpy as np\n","import joblib\n","from scipy.sparse import hstack\n","from ml_sintomas_lexico_v3 import (\n","    SintomasModel, SymptomLexicon, LEXICO_SINTOMAS\n",")\n","\n","# 1) Caminho do modelo\n","if \"WS_DIR\" in globals():\n","    MODEL_PATH = Path(WS_DIR) / \"modelo_sintomas_v3_nolex.pkl\"\n","else:\n","    MODEL_PATH = Path(\"/content/modelo_sintomas_v3_nolex.pkl\")\n","\n","assert MODEL_PATH.exists(), f\"Modelo não encontrado em: {MODEL_PATH}\"\n","\n","# 2) Carregar modelo\n","model = joblib.load(MODEL_PATH)\n","assert isinstance(model, SintomasModel)\n","\n","# Garante léxico por compatibilidade\n","if getattr(model, \"lexicon\", None) is None:\n","    model.lexicon = SymptomLexicon(LEXICO_SINTOMAS, {})\n","\n","# 3) Predição aplicando thresholds (usa os salvos no modelo ou 0.35 como padrão)\n","def predict_with_thresholds(model: SintomasModel, texts, min_thr=0.35):\n","    if isinstance(texts, str):\n","        texts = [texts]\n","\n","    Xw = model.vectorizer.transform(texts)\n","    Xc = model.vectorizer_char.transform(texts) if getattr(model, \"vectorizer_char\", None) is not None else None\n","    X  = hstack([Xw, Xc]) if Xc is not None else Xw\n","\n","    if hasattr(model.clf, \"predict_proba\"):\n","        P = model.clf.predict_proba(X)\n","        if isinstance(P, list):\n","            P = np.column_stack([p[:, 1] if (p.ndim == 2 and p.shape[1] == 2) else p.ravel() for p in P])\n","    else:\n","        from scipy.special import expit\n","        P = expit(model.clf.decision_function(X))\n","\n","    classes = list(model.mlb.classes_)\n","    thr = getattr(model, \"thresholds_\", None)\n","    if thr is None or len(thr) != len(classes):\n","        thr = np.full(len(classes), min_thr, dtype=float)\n","\n","    preds = []\n","    for i in range(P.shape[0]):\n","        probs = P[i]\n","        yhat = (probs >= np.maximum(thr, min_thr)).astype(int)\n","        idxs = np.where(yhat == 1)[0]\n","        labels = [classes[k] for k in idxs]\n","        preds.append(labels)\n","    return preds\n","\n","def show_preds(frases, min_thr=0.35):\n","    preds = predict_with_thresholds(model, frases, min_thr=min_thr)\n","    for f, labs in zip(frases, preds):\n","        print(f'\"{f}\" -> {labs}')\n","\n","# 4) Teste rápido\n","frases_teste = [\n","    \"Tô com mó dor no peito faz uns 2 dias\",\n","    \"Quando tento ler, tá tudo embaçando aos poucos\",\n","    \"Meu bebê tá com febre e chorando muito\",\n","    \"Engasguei com a carne no almoço e faltou ar\",\n","    \"Peito tá queimando\"\n","]\n","show_preds(frases_teste, min_thr=0.65)\n"]},{"cell_type":"code","source":["# ===== AUDITORIA COMPLETA DO DATASET =====\n","import pandas as pd\n","from sklearn.preprocessing import MultiLabelBinarizer\n","from ml_sintomas_lexico_v3 import carregar_base_csv, LEXICO_SINTOMAS, normalize_labels\n","\n","# --- Configuração: caminho/planilha ---\n","CSV = \"https://docs.google.com/spreadsheets/d/1VR7_i3A_ezlgKKGDetvRuYaaM9XQBOqxY-bfuzQxjwU/edit?usp=sharing\"\n","\n","# 1) Carregar base\n","texts, labels = carregar_base_csv(CSV, text_col=\"frase\", labels_col=\"sintomas\", labels_sep=\";\")\n","print(f\"Total de amostras no dataset: {len(texts)}\\n\")\n","\n","# 2) Normalizar labels p/ o léxico\n","classes = list(dict.fromkeys([c.strip() for c in LEXICO_SINTOMAS if c.strip()]))\n","labels_norm = normalize_labels(labels, classes)\n","\n","# 3) Binarizar\n","mlb = MultiLabelBinarizer(classes=classes)\n","Y = mlb.fit_transform(labels_norm)\n","\n","# 4) Frequência por classe\n","freqs = Y.sum(axis=0)\n","\n","# 5) Detectar colunas \"sem variação\" (sempre 0 ou sempre 1)\n","sempre_zero = [cls for cls, f in zip(classes, freqs) if f == 0]\n","sempre_um   = [cls for cls, f in zip(classes, freqs) if f == len(texts)]\n","\n","print(f\"Número de classes no léxico: {len(classes)}\")\n","print(f\"Classes SEMPRE 0 (nunca aparecem): {len(sempre_zero)}\")\n","if sempre_zero:\n","    print(\" -\", \", \".join(sempre_zero[:20]), \"...\" if len(sempre_zero) > 20 else \"\")\n","print(f\"Classes SEMPRE 1 (todas as amostras): {len(sempre_um)}\")\n","if sempre_um:\n","    print(\" -\", \", \".join(sempre_um))\n","\n","# 6) Mostrar tabela completa de frequências\n","df_freqs = pd.DataFrame({\n","    \"Sintoma\": classes,\n","    \"Frequência\": freqs\n","}).sort_values(\"Frequência\", ascending=False).reset_index(drop=True)\n","\n","print(\"\\n=== Frequência por sintoma (completo) ===\")\n","print(df_freqs.to_string(index=False))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2Ct43hIv4_Jg","executionInfo":